@startuml DATABASE

' Класс Пользователь
class User {
    +id : UUID <<PK>>
    +name : VARCHAR
    +email : VARCHAR
    +created_at : TIMESTAMP
}

' Класс Задача
class Task {
    +task_id : UUID <<PK>>
    +parent_task_id : UUID <<FK>>
    +owner_id : UUID <<FK>>
    +project_name : VARCHAR
    +title : VARCHAR
    +description : TEXT
    +status : VARCHAR
    +priority : VARCHAR
    +tags : TEXT
    +due_date : TIMESTAMP
    +created_at : TIMESTAMP
    +updated_at : TIMESTAMP
    +deleted_at : TIMESTAMP
}

' Класс Календарь
class CalendarEvent {
    +event_id : INT <<PK>>
    +task_id : UUID <<FK>>
    +start_time : TIMESTAMP
    +end_time : TIMESTAMP
    +location : VARCHAR
    +external_event_id : VARCHAR
    +external_calendar_account_id : INT <<FK>>
}

' Класс Правило
class Rule {
    +rule_id : INT <<PK>>
    +user_id : UUID <<FK>>
    +event : VARCHAR        
    +condition : TEXT       
    +action : TEXT          
    +is_active : BOOLEAN
}

' Класс Уведомление
class Notification {
    +notification_id : INT <<PK>>
    +task_id : UUID <<FK>>
    +service_id : INT <<FK>>
    +text : TEXT
    +scheduled_at : TIMESTAMP
    +sent_at : TIMESTAMP
    +status : VARCHAR
}

' Класс Сервис для уведомлений
class Service {
    +service_id : INT <<PK>>
    +name : VARCHAR
}

' Класс для хранения ключей доступа к календарю пользователя
class ExternalCalendarAccount {
    +id : INT <<PK>>
    +user_id : UUID <<FK>>
    +provider : VARCHAR
    +access_token : TEXT
    +refresh_token : TEXT
    +expires_at : TIMESTAMP
}

' Класс CommandRequest
class CommandRequest {
    +command_request_id : UUID <<PK>>
    +owner_id : UUID <<FK>>
    +intent : VARCHAR
    +payload : JSON
    +status : VARCHAR
    +confirmation_required : BOOLEAN
    +created_at : TIMESTAMP
    +updated_at : TIMESTAMP
    +canceled_at : TIMESTAMP
    +accepted_at : TIMESTAMP
}

' Класс CommandRequestTask
class CommandRequestTask {
    +command_request_id : UUID <<FK>>
    +task_id : UUID <<FK>>
}

User "1" --> "0..*" Task : владеет
Task "1" <-- "0..*" CalendarEvent : события задачи
Task "1" <-- "0..*" Notification : уведомления по задаче
User "1" --> "0..*" Rule : правила пользователя
Service "1" --> "0..*" Notification : отправляет уведомления
User "1" --> "0..*" ExternalCalendarAccount : аккаунты календаря
CalendarEvent "0..*" -- "1" ExternalCalendarAccount : связанный аккаунт
User "1" --> "0..*" CommandRequest : владеет
CommandRequest "1" --> "0..*" CommandRequestTask
CommandRequestTask "0..*" --> "1" Task

@enduml